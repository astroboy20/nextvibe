14:T574,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Do guests need to download an app to share photos?","acceptedAnswer":{"@type":"Answer","text":"No. Guests scan the QR code with their phone's native camera and are taken directly to the shared album in their mobile browser. No app download is required for uploading photos to the shared party album."}},{"@type":"Question","name":"How many photos can guests upload?","acceptedAnswer":{"@type":"Answer","text":"NextVibe is designed to handle high-volume events. Guests can upload photos and short videos throughout the event with no per-guest limits on the shared album."}},{"@type":"Question","name":"Can I download all the photos after the party?","acceptedAnswer":{"@type":"Answer","text":"Yes. The event organiser can download all photos and videos from the shared album in full resolution after the event. Guests can also download individual photos they want to keep."}},{"@type":"Question","name":"How is NextVibe different from a Google Photos shared album?","acceptedAnswer":{"@type":"Answer","text":"Google Photos requires all guests to have a Google account and manually accept a sharing invite. NextVibe works via QR code — any guest can join instantly. You also get event-specific features like VibeTags, games, RSVP management, and digital postcards that don't exist in Google Photos."}}]}8:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$14"}}]
