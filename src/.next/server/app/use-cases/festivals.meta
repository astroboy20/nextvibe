{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/use-cases/layout,_N_T_/use-cases/festivals/layout,_N_T_/use-cases/festivals/page,_N_T_/use-cases/festivals"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/use-cases/festivals/__PAGE__",
    "/use-cases/festivals",
    "/use-cases",
    "/_index",
    "/_head"
  ]
}