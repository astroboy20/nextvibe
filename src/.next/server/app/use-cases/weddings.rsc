14:T53d,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Do wedding guests need to download an app to upload photos?","acceptedAnswer":{"@type":"Answer","text":"No. Guests scan the QR code with their phone camera and are taken directly to the shared wedding album in their mobile browser. There's no app to download and no account needed to contribute photos."}},{"@type":"Question","name":"Can we use NextVibe for both RSVP and photo sharing?","acceptedAnswer":{"@type":"Answer","text":"Yes. NextVibe handles the full wedding digital experience — RSVP collection, automated reminders, shared photo album via QR code, VibeTags, digital postcards, and a permanent memory archive."}},{"@type":"Question","name":"Will guests' photos be full resolution?","acceptedAnswer":{"@type":"Answer","text":"Yes. Unlike WhatsApp or social media, NextVibe stores photos at full resolution. After the wedding, the couple can download all guest photos in full quality for printing and archiving."}},{"@type":"Question","name":"How early should we set up our wedding VibeTag?","acceptedAnswer":{"@type":"Answer","text":"We recommend setting up your wedding event on NextVibe 4–6 weeks before the wedding. This lets you share the link with guests early, use it for RSVP management, and build pre-wedding excitement."}}]}8:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$14"}}]
