{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/earnings/layout,_N_T_/(app)/earnings/page,_N_T_/earnings"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/earnings/__PAGE__",
    "/!KGFwcCk/earnings",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}