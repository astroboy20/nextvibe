    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/rewards/layout,_N_T_/(app)/rewards/page,_N_T_/rewards"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/rewards/__PAGE__",
    "/!KGFwcCk/rewards",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}